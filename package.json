{
  "name": "brand-name-explorer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite web --config web/vite.config.ts --host 127.0.0.1",
    "build": "tsc --noEmit && vite build web --config web/vite.config.ts && node scripts/build-cli.mjs && node web/scripts/build-sw.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "cli": "node dist/cli.mjs",
    "preview:pages": "node web/scripts/preview.mjs",
    "test:browser": "node web/scripts/verify-browser.mjs",
    "test:names": "node web/scripts/verify-names.mjs",
    "test:check": "node web/scripts/verify-check.mjs",
    "test:resume": "node web/scripts/verify-resume.mjs",
    "measure:load": "node web/scripts/measure-load.mjs",
    "measure:memory": "node web/scripts/measure-memory.mjs",
    "benchmark:core": "node --expose-gc --import tsx web/scripts/benchmark-core.ts",
    "benchmark:browser": "node web/scripts/benchmark-search.mjs",
    "test:feed": "node web/scripts/verify-feed.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/node": "^24.0.0",
    "lighthouse": "^13.6.0",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=24.12"
  },
  "bin": {
    "bne": "dist/cli.mjs"
  }
}
